		"tests/provider/onAwarenessChange.ts",
		"tests/provider/onAwarenessUpdate.ts",
		"tests/provider/onClose.ts",
		"tests/provider/onConnect.ts",
		"tests/provider/onDisconnect.ts",
		"tests/provider/onMessage.ts",
