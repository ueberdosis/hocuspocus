{
  "name": "@hocuspocus/extension-s3",
  "version": "4.6.0",
  "description": "a S3-compatible persistence driver for Hocuspocus",
  "keywords": [
    "hocuspocus",
    "persistence",
    "s3",
    "yjs"
  ],
  "homepage": "https://hocuspocus.dev",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/ueberdosis/hocuspocus"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "main": "dist/hocuspocus-s3.cjs",
  "module": "dist/hocuspocus-s3.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    "source": {
      "import": "./src/index.ts"
    },
    "default": {
      "import": "./dist/hocuspocus-s3.esm.js",
      "require": "./dist/hocuspocus-s3.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@hocuspocus/extension-database": "workspace:^",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  }
}
